<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <template id="pay_inherit" inherit_id="payment.pay">
        <xpath expr="//t[@t-call='payment.summary_item'][2]" position="after">
            <t t-if="surcharge_amount">
                <t t-call="payment.summary_item">
                    <t t-set="name" t-value="'surcharge_amount'" />
                    <t t-set="label">Surcharge Amount</t>
                    <t t-set="value" t-value="surcharge_amount" />
                    <t
                        t-set="options"
                        t-value="{'widget': 'monetary', 'display_currency': currency}"
                    />
                </t>
                <t t-call="payment.summary_item">
                    <t t-set="name" t-value="'base_total_amount'" />
                    <t t-set="label">Amount Due</t>
                    <t t-set="value" t-value="base_total_amount" />
                    <t t-set="include_separator" t-value="True" />
                    <t
                        t-set="options"
                        t-value="{'widget': 'monetary', 'display_currency': currency}"
                    />
                </t>
            </t>
        </xpath>
    </template>

    <template id="payment_checkout_inherit_multi" inherit_id="payment.form">
        <xpath expr="//form[@id='o_payment_form']" position="attributes">
            <attribute name="t-att-data-invoices">invoices</attribute>
            <attribute name="t-att-data-surcharge-amount">surcharge_amount</attribute>
        </xpath>
    </template>
</odoo>
