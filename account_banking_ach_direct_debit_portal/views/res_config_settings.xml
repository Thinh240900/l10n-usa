<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.payment</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//block[@id='analytic']" position="after">
                <h2>Plaid</h2>
                <block id="transfer_journal">
                    <setting>
                        <div class="content-group">
                            <div class="row mt16">
                                <label for="plaid_env" class="col-md-6 o_light_label" />
                                <field name="plaid_env" />
                            </div>
                        </div>
                    </setting>

                    <setting>
                        <div class="content-group">
                            <div class="row mt16">
                                <label
                                    for="plaid_client_id"
                                    class="col-md-6 o_light_label"
                                />
                                <field name="plaid_client_id" />
                            </div>
                        </div>
                    </setting>
                </block>

                <block>
                    <setting id="plaid_secret">
                        <div class="content-group">
                            <div class="row mt16">
                                <label
                                    for="plaid_secret"
                                    class="col-md-6 o_light_label"
                                />
                                <field name="plaid_secret" password="True" />
                            </div>
                        </div>
                    </setting>

                    <setting id="unique_bank_account_setting">
                        <field name="unique_bank_account" class="o_light_label" />
                        <div class="text-muted">
                                Control how bank account uniqueness is enforced (module-specific usage).
                            </div>
                    </setting>
                </block>

                <h2>Bank account</h2>
                <block id="plaid_discount_settings">
                    <setting id="discount_account_id_setting">
                        <label for="discount_account_id" />
                        <div class="text-muted">
                                Account to use for plaid discount.
                            </div>
                        <div class="content-group">
                            <div class="mt16">
                                <field
                                    name="discount_account_id"
                                    class="o_light_label"
                                />
                            </div>
                        </div>
                        <label for="discount_journal_id" />
                        <div class="text-muted">
                                Journal to use for discount.
                            </div>
                        <div class="content-group">
                            <div class="mt16">
                                <field
                                    name="discount_journal_id"
                                    class="o_light_label"
                                />
                            </div>
                        </div>
                    </setting>

                    <setting id="charge_account_id_setting">
                        <label for="charge_account_id" />
                        <div class="text-muted">
                                Account to use for plaid charge.
                            </div>
                        <div class="content-group">
                            <div class="mt16">
                                <field name="charge_account_id" class="o_light_label" />
                            </div>
                        </div>
                    </setting>
                </block>
                <h2>Credit Card</h2>
                <block id="credit_card_general_settings">
                    <setting id="credit_card_surcharge_settings">
                        <label for="credit_card_surcharge" />
                        <div class="text-muted">
                                Surcharge percentage to apply when customers pay with a credit card on the portal.
                            </div>
                        <div class="content-group">
                            <div class="mt16">
                                <field
                                    name="credit_card_surcharge"
                                    class="o_light_label"
                                />
                            </div>
                        </div>
                    </setting>
                    <setting id="surcharge_account_id_setting">
                        <label for="surcharge_account_id" />
                        <div class="text-muted">
                                Account to use for credit card surcharges.
                            </div>
                        <div class="content-group">
                            <div class="mt16">
                                <field
                                    name="surcharge_account_id"
                                    class="o_light_label"
                                />
                            </div>
                        </div>
                    </setting>
                </block>
                <h2>ACH Payment Portal Activation</h2>
                <block id="payment_portal_activation_settings">
                    <setting>
                        <div class="text-muted">
                            <p
                                class="mb-0"
                            >Controls who can access the ACH Payment Portal features:</p>
                            <ul class="">
                                <li>Disabled: Hide all ACH portal features</li>
                                <li
                                >Selected Users Only: Show to users with 'Enable ACH Payment Portal' enabled</li>
                                <li
                                >All Portal Users: Enable ACH features for all portal users</li>
                            </ul>
                        </div>
                        <label for="enable_portal" />
                        <div>
                            <field name="enable_portal" />
                        </div>
                    </setting>

                    <setting>
                        <label for="autopay_enrollment_template_id" />
                        <div class="text-muted">
                                Email template sent to customers when they enroll for AutoPay. Leave empty to disable sending.
                            </div>
                        <div class="content-group">
                            <div class="mt16">
                                <field
                                    name="autopay_enrollment_template_id"
                                    class="o_light_label"
                                />
                            </div>
                        </div>
                    </setting>
                </block>

                <h3>
                    <strong>Auto Pay Options</strong>
                </h3>
                <div id="plaid_auto_pay_rules">
                    <block>
                        <setting id="autopay_enable_end_of_month">
                            <field
                                name="autopay_enable_end_of_month"
                                class="o_light_label"
                            />
                        </setting>

                        <setting id="autopay_enable_on_due_date">
                            <field
                                name="autopay_enable_on_due_date"
                                class="o_light_label"
                            />
                        </setting>
                    </block>

                    <block>
                        <setting id="autopay_enable_specific_date">
                            <field
                                name="autopay_enable_specific_date"
                                class="o_light_label"
                            />
                        </setting>
                    </block>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
